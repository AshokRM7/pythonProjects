# OpenAI API Key (via OpenRouter)
# Get your API key from: https://openrouter.ai/
OPENAI_API_KEY= "your_API_key"
ENABLE_PCAT=true
PCAT_TEMPLATE_PATH=backend/data/pcat/metadata_validation_template_mock.xlsx

# ── Email via Outlook COM (PowerShell) ──────────────────────────────────────
# Gmail SMTP settings have been removed.
# Outlook is used instead via scripts/outlook/Send-OutlookEmail.ps1
# Set to true to send real emails through Outlook; false to simulate.
EMAIL_SENDING_ENABLED=true

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_PCAT=true