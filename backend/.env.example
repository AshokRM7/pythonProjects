# Copy this file to backend/.env and fill in your values.

# ── LLM (optional but recommended) ─────────────────────────────────────────
# Paste your OpenAI API key here. Leave blank to run in rules-only mode.
OPENAI_API_KEY=

# Model used for classification + CAM narrative
OPENAI_MODEL=gpt-4o-mini

# Which LLM features to enable (comma separated): classification, narrative
LLM_ENABLED_FEATURES=classification,narrative

# ── Analysis policy thresholds ─────────────────────────────────────────────
# Transactions at/above this amount raise a high-value alert
HIGH_VALUE_TXN_THRESHOLD=100000

# Warn when cash deposits exceed this fraction of total inflow (0.40 = 40%)
CASH_INTENSITY_WARN_RATIO=0.40

# Maximum Fixed-Obligation-to-Income Ratio allowed by policy (0.55 = 55%)
FOIR_MAX=0.55
