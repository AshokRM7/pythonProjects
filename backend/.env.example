# Copy this file to backend/.env and fill in your values.

# ── LLM (optional but recommended) ─────────────────────────────────────────
# Paste your OpenAI API key here. Leave blank to run in rules-only mode.
OPENAI_API_KEY=

# Model used for classification + CAM narrative
OPENAI_MODEL=gpt-4o-mini

# Which LLM features to enable (comma separated): classification, narrative
LLM_ENABLED_FEATURES=classification,narrative

# ── OCR (for PDFs with no selectable text) ─────────────────────────────────
# Some banks flatten statement text into images/vector outlines. Those pages
# have no text to extract, so they must be read by OCR.
#   auto      = use Tesseract if installed, else AI vision (needs OPENAI_API_KEY)
#   tesseract = force Tesseract (free/offline; install it separately)
#   openai    = force AI vision
#   off       = disable OCR entirely
OCR_ENGINE=auto
OCR_ENABLED=true

# Render resolution. Higher = more accurate but slower. 300 is a good default.
OCR_DPI=300

# Safety cap on pages read per file (raise for very long statements)
OCR_MAX_PAGES=120

# Pages read in parallel by AI vision
OCR_CONCURRENCY=6

# Re-read pages whose figures fail the running-balance check (0 to disable)
OCR_REPAIR_PASSES=1

# Vision model. Use a strong model — small/mini models misread dense number
# columns in financial tables.
OPENAI_VISION_MODEL=gpt-4o

# ── Analysis policy thresholds ─────────────────────────────────────────────
# Transactions at/above this amount raise a high-value alert
HIGH_VALUE_TXN_THRESHOLD=100000

# Warn when cash deposits exceed this fraction of total inflow (0.40 = 40%)
CASH_INTENSITY_WARN_RATIO=0.40

# Maximum Fixed-Obligation-to-Income Ratio allowed by policy (0.55 = 55%)
FOIR_MAX=0.55
