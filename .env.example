# Set to "mock" to run the full pipeline without any API keys (great for learning)
OPENAI_API_KEY=mock

# --- Real evaluation mode (uncomment and fill in) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Langfuse observability (optional — framework works without it)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Quality gate thresholds (0.0 - 1.0)
GATE_FAITHFULNESS_MIN=0.70
GATE_ANSWER_RELEVANCY_MIN=0.70
GATE_CONTEXT_PRECISION_MIN=0.60
